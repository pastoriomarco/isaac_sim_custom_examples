#usda 1.0
(
    defaultPrim = "ur10e_robotiq2f_140_ROS"
    metersPerUnit = 1
    subLayers = [
        @./ur10e_robotiq2f-140_ROS.usd@
    ]
    upAxis = "Z"
)

# Preserve the qualified binary robot stage and author only the stronger
# ManyForge substitutions needed by the corrected gripper contract.
over "ur10e_robotiq2f_140_ROS"
{
    over "ur10e_robotiq2f_140" (
        delete payload = @./UniversalRobots/ur10e/ur10e.usd@
        prepend payload = @./UniversalRobots/ur10e/ur10e_manyforge.usda@
    )
    {
        over "Robotiq_2F_140_config" (
            active = false
        )
        {
        }

        over "gripper" (
            active = false
        )
        {
        }

        over "ee_link"
        {
            # Match the imported wrist pose and ee_joint frame before PhysX
            # starts so the rigid gripper has no first-Play correction.
            quatd xformOp:orient = (0.5, -0.5, 0.5, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }
}
