#usda 1.0
(
    defaultPrim = "UF_ROBOT"
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @./configuration/uf_lite_gripper_robot_schema.usda@
    ]
)

def Xform "UF_ROBOT" (
    kind = "assembly"
    variants = {
        string Physics = "PhysX"
    }
    prepend variantSets = ["Physics"]
    prepend references = @./configuration/uf_lite_gripper_base.usda@</UF_ROBOT>
)
{
    variantSet "Physics" = {
        "None" {
        }
        "PhysX" (
            prepend payload = @./configuration/uf_lite_gripper_physics.usda@</UF_ROBOT>
        ) {
        }
    }
}
