#usda 1.0
(
    defaultPrim = "UF_ROBOT"
    metersPerUnit = 1
    upAxis = "Z"
)

over Xform "UF_ROBOT"
{
    over Xform "world" (
        apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
        float physics:mass = 0
        rel physics:simulationOwner
        def PhysicsFixedJoint "world_joint"
        {
            rel physics:body0 = </UF_ROBOT/world>
            rel physics:body1 = </UF_ROBOT/link_base>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            point3f physics:localPos0 = (0, 0, 0)
