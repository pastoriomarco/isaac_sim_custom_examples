#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

over "UF_ROBOT"
{
    over "link6"
    {
        def Xform "sensors"
        {
            def Xform "camera_link"
            {
                quatd xformOp:orient = (0, 0.7071067811865476, 0, 0.7071067811865475)
                double3 xformOp:translate = (0.06746, 0.0, 0.0237)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

                def Xform "rsd455" (
                    prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.0/Isaac/Sensors/Intel/RealSense/rsd455.usd@</Root/RSD455>
                    delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    quatd xformOp:orient = (0, 0, 0, 1)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (0, 0, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                    over "Imu_Sensor" (
                        active = false
                    )
                    {
                    }
                }
            }
        }
    }
}
