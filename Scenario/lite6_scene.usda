#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @../Robots/Ufactory/lite6/lite6.usda@,
        @../Robots/Ufactory/lite6/graphs/ros_joint_states.usda@,
        @../Robots/Ufactory/lite6/graphs/ros_camera.usda@,
        @../Robots/Ufactory/lite6/graphs/ros_tf.usda@,
        @./physics_scene.usda@
    ]
)

over "Graph" (
    variants = {
        string Gripper = "None"
        string JointStates = "On"
        string Camera = "Off"
        string TF = "Off"
    }
    prepend variantSets = ["JointStates", "Camera", "TF", "Gripper"]
)
{
    variantSet "JointStates" = {
        "Off" {
            over "ROS_JointStates" (
                active = false
            )
            {
            }
        }
        "On" {
            over "ROS_JointStates" (
                active = true
            )
            {
            }
        }
    }

    variantSet "Camera" = {
        "Off" {
            over "ROS_Camera" (
                active = false
            )
            {
            }
        }
        "On" {
            over "ROS_Camera" (
                active = true
            )
            {
            }
        }
    }

    variantSet "TF" = {
        "Off" {
            over "ROS_TF" (
                active = false
            )
            {
            }
        }
        "On" {
            over "ROS_TF" (
                active = true
            )
            {
            }
        }
    }

    variantSet "Gripper" = {
        "None" {
            over "ROS_JointStates"
            {
                over "SubscriberJointStateGripper" (
                    active = false
                )
                {
                }
                over "ArticulationControllerGripper" (
                    active = false
                )
                {
                }
            }
        }
        "lite_gripper" {
            over "ROS_JointStates"
            {
                over "SubscriberJointStateGripper" (
                    active = true
                )
                {
                }
                over "ArticulationControllerGripper" (
                    active = true
                )
                {
                }
            }
        }
    }
}
