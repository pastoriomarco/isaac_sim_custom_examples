#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @../Robots/Ufactory/lite6/lite6.usda@,
        @../Robots/Ufactory/lite6/graphs/ros_joint_states.usda@,
        @./physics_scene.usda@
    ]
)

over "UF_ROBOT" (
    variants = {
        string Gripper = "lite_gripper"
    }
)
{
}

over "Graph" (
    variants = {
        string Gripper = "lite_gripper"
        string ROS = "JointStates"
    }
    prepend variantSets = ["ROS", "Gripper"]
)
{
    variantSet "ROS" = {
        "None" {
            over "ROS_JointStates" (
                active = false
            )
            {
            }
        }
        "JointStates" {
            over "ROS_JointStates" (
                active = true
            )
            {
            }
        }
    }

    variantSet "Gripper" = {
        "None" {
            over "ROS_JointStates"
            {
                over "SubscriberJointStateGripper" (
                    active = false
                )
                {
                }
                over "ArticulationControllerGripper" (
                    active = false
                )
                {
                }
            }
        }
        "lite_gripper" {
            over "ROS_JointStates"
            {
                over "SubscriberJointStateGripper" (
                    active = true
                )
                {
                }
                over "ArticulationControllerGripper" (
                    active = true
                )
                {
                }
            }
        }
    }
}
