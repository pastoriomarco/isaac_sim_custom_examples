    variantSet "ExternalCameraAssets" = {
        "0" {
            over "rsd455" (
                active = false
            )
            {
            }
            over "rsd455_2" (
                active = false
            )
            {
            }
        }
        "1" {
            over "rsd455" (
                active = true
            )
            {
            }
            over "rsd455_2" (
                active = false
            )
            {
