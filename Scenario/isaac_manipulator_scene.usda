    defaultPrim = "World"
    endTimeCode = 100
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "background" (
    prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.1/Isaac/Environments/Simple_Room/simple_room.usd@
)
{
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    over "GroundPlane"
    {
        token visibility = "inherited"
    }

    over "Towel_Room01_floor_bottom_218"
    {
        double3 xformOp:rotateZYX = (0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.11680934882163717, 1.305869970811531, -0.76956998279877)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]
    }

    over "table_low_327"
    {
        double3 xformOp:rotateZYX = (0, 0, 0)
        double3 xformOp:scale = (1, 1.5, 1.149999976158142)
        double3 xformOp:translate = (0, 0, -0.7695999827980996)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale"]

        over "table_low" (
            prepend apiSchemas = ["PhysxConvexHullCollisionAPI", "PhysxConvexDecompositionCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexDecomposition"
            float physxConvexDecompositionCollision:errorPercentage = 1
            bool physxConvexDecompositionCollision:shrinkWrap = 1
        }
    }

    over "DomeLight"
    {
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (0.009999999776482582, 0.009999999776482582, 0.009999999776482582)
        double3 xformOp:translate = (0, 0, -0.007756443890224507)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}

def "Viewport_Measure" (
    hide_in_stage_window = true
)
{
}

